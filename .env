

# --- Ollama (LLM local, tourne sur votre CPU) ---
# Aucune clé requise — tout est local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- ChromaDB (base vectorielle locale) ---
# Aucune clé requise — stockage sur disque
CHROMA_DIR=./chroma_db

# --- Embeddings locaux ---
# Aucune clé requise — modèle téléchargé ~90MB une fois
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Laravel (votre projet existant) ---
LARAVEL_API_URL=http://localhost:8000/api
# Générer avec : php artisan tinker
# >>> \App\Models\User::where('email','carai@careasy.ai')->first()->createToken('ai')->plainTextToken
LARAVEL_AI_TOKEN=118|E5brS0bSE9a2sIcHzZtqSc1xkDr6xY82mxmZQjF8cfb8336a

# --- YouTube (optionnel, gratuit avec quota) ---
YOUTUBE_API_KEY=

# --- Audio ---
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

# --- Flask ---
FLASK_ENV=development
FLASK_PORT=5000